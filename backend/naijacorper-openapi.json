  "info": {
    "title": "NaijaCorper API",
    "description": "Backend API for the NaijaCorper platform",
    "version": "1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "bearer": { "scheme": "bearer", "bearerFormat": "JWT", "type": "http" }
    },
    "schemas": {
      "RegisterDto": {
        "type": "object",
        "properties": {
          "email": { "type": "string" },
          "username": { "type": "string", "minLength": 3 },
          "fullName": { "type": "string", "minLength": 2 },
          "password": {
            "type": "string",
            "minLength": 8,
            "pattern": "/(?=.*[a-z])(?=.*[A-Z])(?=.*\\d)/"
          }
        },
        "required": ["email", "username", "fullName", "password"]
      },
      "LoginDto": {
        "type": "object",
        "properties": {
          "email": { "type": "string" },
          "password": { "type": "string" }
        },
        "required": ["email", "password"]
      },
      "VerifyEmailDto": {
        "type": "object",
        "properties": {
          "email": { "type": "string" },
          "code": { "type": "string", "minLength": 6, "maxLength": 6 }
        },
        "required": ["email", "code"]
      },
      "ResendVerificationDto": {
        "type": "object",
        "properties": { "email": { "type": "string" } },
        "required": ["email"]
      },
      "ForgotPasswordDto": {
        "type": "object",
        "properties": { "email": { "type": "string" } },
        "required": ["email"]
      },
      "ResetPasswordDto": {
        "type": "object",
        "properties": {
          "email": { "type": "string" },
          "code": { "type": "string", "minLength": 6, "maxLength": 6 },
          "newPassword": {
            "type": "string",
            "minLength": 8,
            "pattern": "/(?=.*[a-z])(?=.*[A-Z])(?=.*\\d)/"
          }
        },
        "required": ["email", "code", "newPassword"]
      },
      "JourneyStageDto": {
        "type": "object",
        "properties": {
          "stage": {
            "type": "string",
            "enum": ["PREPARING", "SERVING", "COMPLETED"]
          }
        },
        "required": ["stage"]
      },
      "ProspectiveDetailsDto": {
        "type": "object",
        "properties": {
          "nyscStage": {
            "type": "string",
            "enum": [
              "WAITING_MOBILIZATION",
              "WAITING_CALLUP",
              "WAITING_DEPLOYMENT",
              "RECEIVED_CALLUP",
              "PREPARING_CAMP",
              "OTHER"
            ]
          },
          "state": { "type": "string" },
          "interests": {
            "type": "string",
            "enum": [
              "NYSC_UPDATES",
              "ORIENTATION_CAMP",
              "RELOCATION",
              "ACCOMMODATION",
              "JOBS",
              "BUSINESS",
              "TECHNOLOGY",
              "NETWORKING",
              "MAKING_FRIENDS",
              "NYSC_TIPS",
              "CAREER_OPPORTUNITIES"
            ]
          }
        },
        "required": ["nyscStage", "interests"]
      },
      "ServingDetailsDto": {
        "type": "object",
        "properties": {
          "state": { "type": "string" },
          "lga": { "type": "string" },
          "batch": { "type": "string" },
          "stream": { "type": "string" },
          "ppa": { "type": "string" },
          "interests": {
            "type": "string",
            "enum": [
              "COMMUNITY",
              "JOBS",
              "ACCOMMODATION",
              "MARKETPLACE",
              "EXPLORE",
              "EVENTS",
              "BUSINESS",
              "PROFESSIONAL_NETWORKING",
              "TECHNOLOGY",
              "ENTREPRENEURSHIP",
              "CAREER_DEVELOPMENT"
            ]
          }
        },
        "required": ["state", "lga", "batch", "stream", "interests"]
      },
      "VerificationDocumentDto": {
        "type": "object",
        "properties": { "documentUrl": { "type": "string" } },
        "required": ["documentUrl"]
      },
      "CreatePostDto": {
        "type": "object",
        "properties": {
          "content": { "type": "string", "maxLength": 2000 },
          "mediaUrls": { "type": "array", "items": { "type": "string" } },
          "repostOfId": { "type": "string" }
        }
      },
      "UpdateNotificationPreferencesDto": {
        "type": "object",
        "properties": {
          "likes": { "type": "boolean" },
          "comments": { "type": "boolean" },
          "follows": { "type": "boolean" },
          "messages": { "type": "boolean" }
        }
      },
      "CreateCommentDto": {
        "type": "object",
        "properties": {
          "content": { "type": "string", "maxLength": 1000 },
          "parentId": { "type": "string" }
        },
        "required": ["content"]
      },
      "CreateReportDto": {
        "type": "object",
        "properties": {
          "targetType": { "type": "string", "enum": ["POST", "USER"] },
          "targetId": { "type": "string" },
          "reason": { "type": "string", "maxLength": 500 }
        },
        "required": ["targetType", "targetId", "reason"]
      },
      "SendMessageDto": {
        "type": "object",
        "properties": { "content": { "type": "string", "maxLength": 2000 } },
        "required": ["content"]
      },
      "CreateListingDto": {
        "type": "object",
        "properties": {
          "category": {
            "type": "string",
            "enum": [
              "PHONES",
              "LAPTOPS",
              "ELECTRONICS",
              "FURNITURE",
              "FASHION",
              "BOOKS",
              "KITCHEN_ITEMS",
              "VEHICLES",
              "ACCOMMODATION",
              "SERVICES"
            ]
          },
          "title": { "type": "string", "maxLength": 120 },
          "description": { "type": "string", "maxLength": 2000 },
          "price": { "type": "number", "minimum": 0 },
          "state": { "type": "string" },
          "imageUrls": { "type": "array", "items": { "type": "string" } }
        },
        "required": ["category", "title", "description", "price"]
      },
      "UpdateListingDto": {
        "type": "object",
        "properties": {
          "category": {
            "type": "string",
            "enum": [
              "PHONES",
              "LAPTOPS",
              "ELECTRONICS",
              "FURNITURE",
              "FASHION",
              "BOOKS",
              "KITCHEN_ITEMS",
              "VEHICLES",
              "ACCOMMODATION",
              "SERVICES"
            ]
          },
          "title": { "type": "string", "maxLength": 120 },
          "description": { "type": "string", "maxLength": 2000 },
          "price": { "type": "number", "minimum": 0 },
          "state": { "type": "string" },
          "imageUrls": { "type": "array", "items": { "type": "string" } }
        }
      },
      "UpdateListingStatusDto": {
        "type": "object",
        "properties": {
          "status": { "type": "string", "enum": ["AVAILABLE", "SOLD"] }
        },
        "required": ["status"]
      },
      "CreateExploreEntryDto": {
        "type": "object",
        "properties": {
          "category": {
            "type": "string",
            "enum": [
              "ACCOMMODATION",
              "FOOD",
              "RESTAURANTS",
              "MAMI_MARKET",
              "TRANSPORT",
              "HOSPITALS",
              "PHARMACIES",
              "ATMS",
              "CYBERCAFES",
              "PRINTING_SERVICES",
              "MARKETS",
              "NYSC_LOCATIONS",
              "ORIENTATION_CAMPS",
              "SECRETARIATS",
              "PPAS",
              "EVENTS",
              "OTHER"
            ]
          },
          "name": { "type": "string", "maxLength": 120 },
          "description": { "type": "string", "maxLength": 1000 },
          "state": { "type": "string" },
          "rating": { "type": "number", "minimum": 1, "maximum": 5 }
        },
        "required": ["category", "name", "description"]
      },
      "VerificationDecisionDto": {
        "type": "object",
        "properties": {
          "decision": { "type": "string", "enum": ["VERIFIED", "REJECTED"] }
        },
        "required": ["decision"]
      },
      "ReportDecisionDto": {
        "type": "object",
        "properties": {
          "status": { "type": "string", "enum": ["REVIEWED", "DISMISSED"] }
        },
        "required": ["status"]
      }
    }
  },
  "security": [{ "bearer": [] }]
}
