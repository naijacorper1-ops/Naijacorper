generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  // Supabase's pooled connection (DATABASE_URL) can't run migrations —
  // the CLI needs the direct, non-pooled connection for that.
  directUrl = env("DIRECT_URL")
}

// Matches the PRD's onboarding paths. Prospective is the default
// until the onboarding module sets the real status.
enum UserRole {
  PROSPECTIVE_CORPER
  SERVING_CORPER
  EX_CORPER
  BUSINESS
  RECRUITER
  ADMIN
}

// A badge, not a gate. Users can use the app while unverified.
enum VerificationStatus {
  UNVERIFIED
  PENDING
  VERIFIED
  REJECTED
}

// PRD section 7, step 2
enum NyscStage {
  WAITING_MOBILIZATION
  WAITING_CALLUP
  WAITING_DEPLOYMENT
  RECEIVED_CALLUP
  PREPARING_CAMP
  OTHER
}

enum OtpPurpose {
  EMAIL_VERIFICATION
  PASSWORD_RESET
}

// PRD section 28
enum ListingCategory {
  PHONES
  LAPTOPS
  ELECTRONICS
  FURNITURE
  FASHION
  BOOKS
  KITCHEN_ITEMS
  VEHICLES
  ACCOMMODATION
  SERVICES
}

// REMOVED is set only by an admin (moderation). Sellers can't set it,
// and can't edit or re-list a REMOVED listing.
enum ListingStatus {
  AVAILABLE
  SOLD
  REMOVED
}

enum NotificationType {
  LIKE
  COMMENT
  REPLY
  FOLLOW
  MESSAGE
  // System notifications: sent by the platform, not by another user,
  // so they have no actor and ignore the user's preferences.
  VERIFICATION_APPROVED
  VERIFICATION_REJECTED
  LISTING_REMOVED
  CONTENT_REMOVED
}

// PRD section 25
enum ExploreCategory {
  ACCOMMODATION
  FOOD
  RESTAURANTS
  MAMI_MARKET
  TRANSPORT
  HOSPITALS
  PHARMACIES
  ATMS
  CYBERCAFES
  PRINTING_SERVICES
  MARKETS
  NYSC_LOCATIONS
  ORIENTATION_CAMPS
  SECRETARIATS
  PPAS
  EVENTS
  OTHER
}

// PRD section 23
enum ReportTargetType {
  POST
  USER
  COMMENT
  LISTING
  GROUP
}

enum ReportStatus {
  PENDING
  REVIEWED
  DISMISSED
}

// What the user is showing us to prove their NYSC status.
enum VerificationDocumentType {
  NYSC_ID_CARD
  CALL_UP_LETTER
  DISCHARGE_CERTIFICATE
  OTHER
}

enum GroupMemberRole {
  OWNER
  MEMBER
}

model User {
  id                 String             @id @default(uuid())
  email              String             @unique
  username           String             @unique
  fullName           String
  passwordHash       String
  role               UserRole           @default(PROSPECTIVE_CORPER)
  verificationStatus VerificationStatus @default(UNVERIFIED)
  // The only verification field other users ever see. It is true only for
  // VERIFIED, so a rejected or pending request is never exposed publicly.
  isVerified         Boolean            @default(false)
  emailVerified      Boolean            @default(false)

  // Public profile
  bio       String?
  avatarUrl String?

  // Onboarding fields, set by the onboarding module (PRD sections 7 and 8)
  nyscStage           NyscStage?
  state               String?
  lga                 String?
  batch               String?
  stream              String?
  ppa                 String?
  interests           String[]   @default([])
  onboardingCompleted Boolean    @default(false)

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  refreshTokens          RefreshToken[]
  verificationDocuments  VerificationDocument[]
  otpCodes               OtpCode[]
  posts                  Post[]
  likes                  Like[]
  comments               Comment[]
  listings               Listing[]
  notificationsReceived  Notification[]          @relation("NotificationRecipient")
  notificationsSent      Notification[]          @relation("NotificationActor")
  notificationPreference NotificationPreference?
  exploreEntries         ExploreEntry[]
  reportsFiled           Report[]

  // Same pattern as Follow: two relation names per pair to disambiguate
  // which side of the block/mute this user is on.
  blocking  Block[] @relation("UserBlocks")
  blockedBy Block[] @relation("UserBlockedBy")
  muting    Mute[]  @relation("UserMutes")
  mutedBy   Mute[]  @relation("UserMutedBy")

  // Follow is a self-relation: "following" is the edges this user
  // created, "followers" is the edges pointing at this user.
  following Follow[] @relation("UserFollows")
  followers Follow[] @relation("UserFollowedBy")

  // Same normalization pattern as Follow: participantOne/Two is just
  // an ordering, not "who started it" — see Conversation below.
  conversationsAsFirstParticipant  Conversation[] @relation("ConversationParticipantOne")
  conversationsAsSecondParticipant Conversation[] @relation("ConversationParticipantTwo")
  sentMessages                     Message[]

  pollVotes        PollVote[]
  groupsCreated    Group[]       @relation("GroupCreator")
  groupMemberships GroupMember[]

  @@index([state])
  @@index([createdAt])
  @@map("users")
}

// Refresh tokens are opaque random strings, not JWTs, so a single
// row can be revoked immediately without needing a blocklist.
model RefreshToken {
  id        String   @id @default(uuid())
  tokenHash String
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  revoked   Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([tokenHash])
  @@map("refresh_tokens")
}

// One row per submitted document, so re-submissions keep a history
// instead of overwriting the last attempt.
model VerificationDocument {
  id              String                   @id @default(uuid())
  userId          String
  user            User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  documentType    VerificationDocumentType @default(OTHER)
  // The private Cloudinary file. We store its id, never a link, and
  // generate a fresh short-lived link whenever an admin opens it.
  // These are cleared (and the file deleted) once a decision is made.
  publicId        String?
  resourceType    String?
  format          String?
  purgedAt        DateTime?
  // Old rows from before this change only have a (now expired) link.
  documentUrl     String?
  note            String?
  status          VerificationStatus       @default(PENDING)
  rejectionReason String?
  reviewedBy      String?
  reviewedAt      DateTime?
  createdAt       DateTime                 @default(now())

  @@index([userId])
  @@index([status, createdAt])
  @@map("verification_documents")
}

// Shared by email verification and password reset — same shape,
// different purpose. One-time use, hashed, short expiry.
model OtpCode {
  id        String     @id @default(uuid())
  userId    String
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash  String
  purpose   OtpPurpose
  expiresAt DateTime
  consumed  Boolean    @default(false)
  // Wrong guesses against this code. After 5 the code is dead.
  attempts  Int        @default(0)
  createdAt DateTime   @default(now())

  @@index([userId, purpose])
  @@map("otp_codes")
}

// A repost is a Post row with repostOfId set and no content.
// A quote post is a Post row with both content and repostOfId set.
model Post {
  id       String  @id @default(uuid())
  authorId String
  author   User    @relation(fields: [authorId], references: [id], onDelete: Cascade)
  content  String?

  mediaUrls String[] @default([])

  repostOfId String?
  repostOf   Post?   @relation("PostReposts", fields: [repostOfId], references: [id], onDelete: SetNull)
  reposts    Post[]  @relation("PostReposts")

  // A post written inside a group. Group posts stay out of the main
  // feed, profiles and hashtag pages; they show up in the group only.
  groupId String?
  group   Group?  @relation(fields: [groupId], references: [id], onDelete: Cascade)

  likeCount    Int @default(0)
  commentCount Int @default(0)
  repostCount  Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  likes    Like[]
  comments Comment[]
  hashtags PostHashtag[]
  poll     Poll?

  @@index([authorId, createdAt])
  @@index([createdAt, id])
  @@index([groupId, createdAt])
  @@index([repostOfId])
  @@map("posts")
}

model Like {
  id        String   @id @default(uuid())
  userId    String
  postId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, postId])
  @@index([postId])
  @@map("likes")
}

// Replies are comments with parentId set — one level of nesting,
// which is all the PRD's "comments and conversations" section asks for.
model Comment {
  id       String @id @default(uuid())
  postId   String
  post     Post   @relation(fields: [postId], references: [id], onDelete: Cascade)
  authorId String
  author   User   @relation(fields: [authorId], references: [id], onDelete: Cascade)
  content  String

  parentId String?
  parent   Comment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies  Comment[] @relation("CommentReplies")

  createdAt DateTime @default(now())

  @@index([postId, createdAt])
  @@index([parentId])
  @@map("comments")
}

model Follow {
  id          String @id @default(uuid())
  followerId  String
  followingId String
  follower    User   @relation("UserFollows", fields: [followerId], references: [id], onDelete: Cascade)
  following   User   @relation("UserFollowedBy", fields: [followingId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([followerId, followingId])
  @@index([followerId])
  @@index([followingId])
  @@map("follows")
}

model Hashtag {
  id    String        @id @default(uuid())
  tag   String        @unique
  posts PostHashtag[]

  @@map("hashtags")
}

model PostHashtag {
  postId    String
  hashtagId String
  post      Post    @relation(fields: [postId], references: [id], onDelete: Cascade)
  hashtag   Hashtag @relation(fields: [hashtagId], references: [id], onDelete: Cascade)

  @@id([postId, hashtagId])
  @@index([hashtagId])
  @@map("post_hashtags")
}

// participantOneId is always the lexicographically smaller user id.
// That normalization, done in MessagingService, is what lets the
// unique constraint catch (A,B) and (B,A) as the same conversation.
model Conversation {
  id               String @id @default(uuid())
  participantOneId String
  participantTwoId String
  participantOne   User   @relation("ConversationParticipantOne", fields: [participantOneId], references: [id], onDelete: Cascade)
  participantTwo   User   @relation("ConversationParticipantTwo", fields: [participantTwoId], references: [id], onDelete: Cascade)

  lastMessageAt DateTime @default(now())
  createdAt     DateTime @default(now())

  messages Message[]

  @@unique([participantOneId, participantTwoId])
  @@index([participantOneId])
  @@index([participantTwoId])
  @@map("conversations")
}

model Message {
  id             String       @id @default(uuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String
  sender         User         @relation(fields: [senderId], references: [id], onDelete: Cascade)
  content        String

  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([conversationId, createdAt])
  @@map("messages")
}

// Price is a whole-Naira Int — no payment processing happens through
// the platform for MVP (Marketplace is discovery + messaging, buyer
// and seller settle payment themselves), so kobo precision isn't needed.
model Listing {
  id          String          @id @default(uuid())
  sellerId    String
  seller      User            @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  title       String
  description String
  price       Int
  category    ListingCategory
  status      ListingStatus   @default(AVAILABLE)
  imageUrls   String[]        @default([])
  state       String?

  // Set when an admin removes the listing. The seller can see why.
  removedReason String?
  removedAt     DateTime?
  removedBy     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([category, createdAt])
  @@index([sellerId, createdAt])
  @@index([status, createdAt])
  @@index([state])
  @@map("listings")
}

// postId/commentId/conversationId are deliberately plain references,
// not enforced Prisma relations — that would require touching Post,
// Comment, and Conversation just to add back-relation arrays for this.
// If the referenced item gets deleted, the notification just goes
// stale; fine for an activity feed, not worth the extra coupling.
model Notification {
  id          String           @id @default(uuid())
  recipientId String
  recipient   User             @relation("NotificationRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  // Null for system notifications (verification result, content removed).
  actorId     String?
  actor       User?            @relation("NotificationActor", fields: [actorId], references: [id], onDelete: Cascade)
  type        NotificationType

  postId         String?
  commentId      String?
  conversationId String?
  listingId      String?
  // Human-readable text for system notifications, e.g. a rejection reason.
  message        String?

  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([recipientId, createdAt])
  @@index([recipientId, read])
  @@map("notifications")
}

model NotificationPreference {
  id     String @id @default(uuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  likes    Boolean @default(true)
  comments Boolean @default(true)
  follows  Boolean @default(true)
  messages Boolean @default(true)

  @@map("notification_preferences")
}

// PRD section 27: one rating/tip per entry, from whoever submitted it.
// Multiple community reviews on the same place is the PRD's own
// "eventually" — explicitly not MVP scope, not built here.
model ExploreEntry {
  id            String          @id @default(uuid())
  submittedById String
  submittedBy   User            @relation(fields: [submittedById], references: [id], onDelete: Cascade)
  name          String
  category      ExploreCategory
  description   String
  state         String
  rating        Int?

  createdAt DateTime @default(now())

  @@index([category, state])
  @@index([submittedById])
  @@index([createdAt, id])
  @@map("explore_entries")
}

// targetId is a plain reference (postId or userId depending on
// targetType) — same "not a real FK" pattern as Notification, for
// the same reason: reporting a post shouldn't require touching Post.
model Report {
  id             String           @id @default(uuid())
  reporterId     String
  reporter       User             @relation(fields: [reporterId], references: [id], onDelete: Cascade)
  targetType     ReportTargetType
  targetId       String
  reason         String
  // A copy of the reported content taken when the report was filed, so an
  // admin can still see what was reported after the owner deletes it.
  snapshot       Json?
  status         ReportStatus     @default(PENDING)
  reviewedBy     String?
  reviewedAt     DateTime?
  // What the admin did: NONE, REMOVE_CONTENT or DEACTIVATE_USER.
  actionTaken    String?
  resolutionNote String?
  createdAt      DateTime         @default(now())

  @@index([status, createdAt])
  @@index([reporterId])
  @@index([targetType, targetId])
  @@map("reports")
}

model Block {
  id        String   @id @default(uuid())
  blockerId String
  blockedId String
  blocker   User     @relation("UserBlocks", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked   User     @relation("UserBlockedBy", fields: [blockedId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([blockerId, blockedId])
  @@index([blockerId])
  @@index([blockedId])
  @@map("blocks")
}

model Mute {
  id        String   @id @default(uuid())
  muterId   String
  mutedId   String
  muter     User     @relation("UserMutes", fields: [muterId], references: [id], onDelete: Cascade)
  muted     User     @relation("UserMutedBy", fields: [mutedId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([muterId, mutedId])
  @@index([muterId])
  @@index([mutedId])
  @@map("mutes")
}

// A poll belongs to exactly one post (the question is the post's content).
// Votes are single-choice, final, and one per user.
model Poll {
  id        String   @id @default(uuid())
  postId    String   @unique
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  options PollOption[]
  votes   PollVote[]

  @@map("polls")
}

model PollOption {
  id        String @id @default(uuid())
  pollId    String
  poll      Poll   @relation(fields: [pollId], references: [id], onDelete: Cascade)
  text      String
  position  Int
  // Denormalized so reading results never has to count vote rows.
  voteCount Int    @default(0)

  votes PollVote[]

  @@index([pollId])
  @@map("poll_options")
}

model PollVote {
  pollId    String
  userId    String
  optionId  String
  poll      Poll       @relation(fields: [pollId], references: [id], onDelete: Cascade)
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  option    PollOption @relation(fields: [optionId], references: [id], onDelete: Cascade)
  createdAt DateTime   @default(now())

  // One vote per user per poll, enforced by the database itself.
  @@id([pollId, userId])
  @@index([optionId])
  @@map("poll_votes")
}

// Groups are the "deeper layer" under the feed (PRD section 22).
// MVP groups are public: anyone can read, members can post.
model Group {
  id          String   @id @default(uuid())
  name        String
  // Lowercase, hyphenated form of the name. Unique, so two groups
  // can't differ only by capital letters or spacing.
  slug        String   @unique
  description String?
  state       String?
  avatarUrl   String?
  createdById String
  createdBy   User     @relation("GroupCreator", fields: [createdById], references: [id], onDelete: Cascade)
  memberCount Int      @default(1)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  members GroupMember[]
  posts   Post[]

  @@index([createdAt, id])
  @@index([state])
  @@index([createdById])
  @@map("groups")
}

model GroupMember {
  id       String          @id @default(uuid())
  groupId  String
  userId   String
  group    Group           @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user     User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  role     GroupMemberRole @default(MEMBER)
  joinedAt DateTime        @default(now())

  @@unique([groupId, userId])
  @@index([groupId, joinedAt])
  @@index([userId, joinedAt])
  @@map("group_members")
}

// Every admin action is written here. adminId and adminUsername are plain
// copies (not a foreign key), so the record survives if the admin account
// is later removed.
model AuditLog {
  id            String   @id @default(uuid())
  adminId       String
  adminUsername String
  action        String
  targetType    String?
  targetId      String?
  reason        String?
  metadata      Json?
  createdAt     DateTime @default(now())

  @@index([createdAt, id])
  @@index([adminId, createdAt])
  @@index([targetType, targetId])
  @@map("audit_logs")
}
