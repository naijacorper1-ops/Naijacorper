NODE_ENV=development
PORT=4000

# Supabase → Project Settings → Database → Connection string.
# DATABASE_URL: the "Transaction pooler" one (port 6543, ends in ?pgbouncer=true) — the app uses this at runtime.
# DIRECT_URL: only the Prisma CLI (migrate) uses this. The "Direct connection" string is IPv6-only on the
# free plan, so use the "Session pooler" string instead (port 5432 on the pooler host).
DATABASE_URL=postgresql://postgres.your-project-ref:your-password@aws-0-region.pooler.supabase.com:6543/postgres?pgbouncer=true
DIRECT_URL=postgresql://postgres:your-password@db.your-project-ref.supabase.co:5432/postgres

# Generate your own with: openssl rand -base64 48  (never commit the real value)
JWT_ACCESS_SECRET=replace-with-your-own-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN_DAYS=30

FRONTEND_URL=http://localhost:5173
COOKIE_DOMAIN=localhost

# From your Cloudinary dashboard homepage, right after signup
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# From your Resend dashboard — FROM_ADDRESS must be on a domain you've verified there
RESEND_API_KEY=your-resend-api-key
RESEND_FROM_ADDRESS=NaijaCorper <noreply@yourdomain.com>
