# ─────────────────────────────────────────────
# NaijaCorper – Frontend environment variables
# Copy to `.env.local` (git-ignored via *.local) and adjust if needed.
# Vite only exposes variables prefixed with VITE_ (baked in at build time).
# ─────────────────────────────────────────────

# REST API base path.
# Keep it RELATIVE: in dev the Vite proxy (vite.config.js) and in production
# the Vercel rewrite (vercel.json) forward /api/v1 -> https://api.naijacorper.com/api/v1.
# This keeps the refresh-token cookie first-party.
VITE_API_BASE_URL=/api/v1

# Socket.IO server origin for real-time messaging (namespace: /messaging).
# Dev: leave EMPTY -> connects to the current origin and the Vite proxy forwards /socket.io (ws).
# Production (Vercel): Vercel rewrites cannot proxy WebSockets, so point directly at the API:
#   VITE_SOCKET_URL=https://api.naijacorper.com
VITE_SOCKET_URL=

# Socket.IO namespace and path (backend defaults)
VITE_SOCKET_NAMESPACE=/messaging
VITE_SOCKET_PATH=/socket.io

# Fallback REST polling interval (ms) – used ONLY while the socket is disconnected
VITE_POLLING_FALLBACK_MS=5000
